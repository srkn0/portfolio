package components

import "context"

templ Hero(ctx context.Context) {
	<section class="flex items-center justify-center min-h-[60vh] px-6">
		<div class="text-center max-w-2xl">
			<h1 class="text-4xl md:text-5xl font-extrabold">Hi, I'm Serkan</h1>
			<p class="mt-4 text-slate-600">Notes and projects.</p>
		</div>
	</section>
}
