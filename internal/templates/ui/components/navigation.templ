package components

import (
	"context"

	"github.com/srkn0/main/internal/templates/constants"
	i18npkg "github.com/srkn0/main/pkg/i18n"
	"github.com/srkn0/main/pkg/templui/icon"
)

templ Sidebar(ctx context.Context) {
	{{ vm := LayoutData(ctx) }}
	<aside class="app-sidebar hidden lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:flex lg:flex-col lg:border-r lg:border-sidebar-border lg:bg-sidebar lg:px-3 lg:py-4">
		<div class="mb-5">
			<a
				href="/"
				hx-get="/"
				hx-target={ "#" + constants.PageLayoutID }
				hx-swap="outerHTML"
				hx-push-url="true"
				class="block min-w-0 rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-sidebar"
			>
				<p class="text-base font-semibold tracking-normal text-sidebar-foreground">{ i18npkg.T(ctx, "site_name") }</p>
			</a>
		</div>

		<div class="flex min-h-0 flex-1 flex-col gap-5 pr-1">
			@SidebarGroup(i18npkg.T(ctx, "sidebar_navigation")) {
				<nav aria-label={ i18npkg.T(ctx, "sidebar_navigation") } class="space-y-1">
					@NavItem(ctx, "/", i18npkg.T(ctx, "nav_home"), icon.House, vm.CurrentPath)
					@NavItem(ctx, "/blog", i18npkg.T(ctx, "nav_writing"), icon.BookOpenText, vm.CurrentPath)
					@NavItem(ctx, "/projects", i18npkg.T(ctx, "nav_projects"), icon.FolderKanban, vm.CurrentPath)
					@NavItem(ctx, "/cv", i18npkg.T(ctx, "nav_cv"), icon.FileUser, vm.CurrentPath)
					@NavItem(ctx, "/contact", i18npkg.T(ctx, "nav_contact"), icon.Mail, vm.CurrentPath)
					@ExternalNavItem(ctx, "https://github.com/srkn0/portfolio", "GitHub", i18npkg.T(ctx, "github_repo"), icon.Github)
				</nav>
			}
		</div>

		<div class="mt-5 flex shrink-0 items-center justify-between gap-2 border-t border-sidebar-border pt-4">
			@LocaleSwitcher(ctx)
			<div class="flex items-center gap-1">
				@ThemeToggle(ctx)
				@AccentMenu(ctx)
			</div>
		</div>
	</aside>
}

templ MobileNav(ctx context.Context) {
	{{ vm := LayoutData(ctx) }}
	<header class="sticky top-0 z-40 border-b border-border bg-background/95 px-4 py-3 backdrop-blur supports-[backdrop-filter]:bg-background/80 lg:hidden">
		<div class="mx-auto flex max-w-[48rem] items-center justify-between gap-3">
			<a
				href="/"
				hx-get="/"
				hx-target={ "#" + constants.PageLayoutID }
				hx-swap="outerHTML"
				hx-push-url="true"
				class="min-w-0 rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
			>
				<span class="block truncate text-sm font-semibold text-foreground">{ i18npkg.T(ctx, "site_name") }</span>
				<span class="block truncate text-xs text-muted-foreground">{ i18npkg.T(ctx, "site_tagline") }</span>
			</a>
			<div class="flex shrink-0 items-center gap-1">
				@LocaleSwitcher(ctx)
				@ThemeToggle(ctx)
				<details class="relative">
					<summary class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background" aria-label={ i18npkg.T(ctx, "mobile_menu_label") }>
						@icon.Menu(icon.Props{Class: "size-4"})
					</summary>
					<div class="absolute right-0 mt-2 w-56 rounded-md border border-border bg-popover p-2 shadow-sm">
						<nav aria-label={ i18npkg.T(ctx, "mobile_menu_label") } class="space-y-1">
							@MobileNavItem(ctx, "/", i18npkg.T(ctx, "nav_home"), vm.CurrentPath)
							@MobileNavItem(ctx, "/blog", i18npkg.T(ctx, "nav_writing"), vm.CurrentPath)
							@MobileNavItem(ctx, "/projects", i18npkg.T(ctx, "nav_projects"), vm.CurrentPath)
							@MobileNavItem(ctx, "/cv", i18npkg.T(ctx, "nav_cv"), vm.CurrentPath)
							@MobileNavItem(ctx, "/contact", i18npkg.T(ctx, "nav_contact"), vm.CurrentPath)
							@MobileExternalNavItem("https://github.com/srkn0/portfolio", "GitHub", i18npkg.T(ctx, "github_repo"))
						</nav>
						<div class="mt-3 flex items-center justify-between border-t border-border pt-3">
							<span class="px-2 text-xs font-medium text-muted-foreground">{ i18npkg.T(ctx, "accent_color") }</span>
							@AccentPicker(ctx)
						</div>
					</div>
				</details>
			</div>
		</div>
	</header>
}

templ SidebarGroup(label string) {
	<section>
		<h2 class="mb-2 px-2 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{ label }</h2>
		{ children... }
	</section>
}

templ NavItem(ctx context.Context, href string, label string, iconFunc func(...icon.Props) templ.Component, currentPath string) {
	<a
		href={ href }
		hx-get={ href }
		hx-target={ "#" + constants.PageLayoutID }
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ NavLinkClass(currentPath, href) }
		if ActivePath(currentPath, href) {
			aria-current="page"
		}
	>
		@iconFunc(icon.Props{Class: "size-4 shrink-0"})
		<span>{ label }</span>
	</a>
}

templ ExternalNavItem(ctx context.Context, href string, label string, ariaLabel string, iconFunc func(...icon.Props) templ.Component) {
	<a
		href={ href }
		class="group flex items-center gap-2 rounded-md px-2 py-1.5 text-sm leading-none text-muted-foreground no-underline outline-none transition-colors hover:bg-accent/70 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
		aria-label={ ariaLabel }
		title={ ariaLabel }
		target="_blank"
		rel="noreferrer"
	>
		@iconFunc(icon.Props{Class: "size-4 shrink-0"})
		<span>{ label }</span>
	</a>
}

templ MobileNavItem(ctx context.Context, href string, label string, currentPath string) {
	<a
		href={ href }
		hx-get={ href }
		hx-target={ "#" + constants.PageLayoutID }
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ CompactLinkClass(currentPath, href) }
		if ActivePath(currentPath, href) {
			aria-current="page"
		}
	>{ label }</a>
}

templ MobileExternalNavItem(href string, label string, ariaLabel string) {
	<a
		href={ href }
		class="block rounded-md px-2 py-1.5 text-sm text-muted-foreground no-underline outline-none transition-colors hover:bg-accent/70 hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
		aria-label={ ariaLabel }
		title={ ariaLabel }
		target="_blank"
		rel="noreferrer"
	>{ label }</a>
}

templ ThemeToggle(ctx context.Context) {
	<button
		id="theme-toggle"
		type="button"
		class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
		onclick="toggleTheme()"
		aria-label={ i18npkg.T(ctx, "theme_toggle") }
		title={ i18npkg.T(ctx, "theme_toggle") }
	>
		<span class="hidden dark:inline-flex">@icon.Sun(icon.Props{Class: "size-4"})</span>
		<span class="inline-flex dark:hidden">@icon.Moon(icon.Props{Class: "size-4"})</span>
	</button>
}

templ AccentMenu(ctx context.Context) {
	<details class="relative">
		<summary
			class="inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
			aria-label={ i18npkg.T(ctx, "accent_color") }
			title={ i18npkg.T(ctx, "accent_color") }
		>
			@icon.Palette(icon.Props{Class: "size-4"})
		</summary>
		<div class="absolute bottom-full right-0 mb-2 flex items-center gap-1.5 rounded-md border border-border bg-popover p-2 shadow-sm" role="radiogroup" aria-label={ i18npkg.T(ctx, "accent_color") } data-accent-picker>
			@AccentOption(ctx, "blue", i18npkg.T(ctx, "accent_blue"))
			@AccentOption(ctx, "green", i18npkg.T(ctx, "accent_green"))
			@AccentOption(ctx, "amber", i18npkg.T(ctx, "accent_amber"))
			@AccentOption(ctx, "rose", i18npkg.T(ctx, "accent_rose"))
			@AccentOption(ctx, "violet", i18npkg.T(ctx, "accent_violet"))
		</div>
	</details>
}

templ AccentPicker(ctx context.Context) {
	<div class="flex items-center gap-1.5" role="radiogroup" aria-label={ i18npkg.T(ctx, "accent_color") } data-accent-picker>
		@AccentOption(ctx, "blue", i18npkg.T(ctx, "accent_blue"))
		@AccentOption(ctx, "green", i18npkg.T(ctx, "accent_green"))
		@AccentOption(ctx, "amber", i18npkg.T(ctx, "accent_amber"))
		@AccentOption(ctx, "rose", i18npkg.T(ctx, "accent_rose"))
		@AccentOption(ctx, "violet", i18npkg.T(ctx, "accent_violet"))
	</div>
}

templ AccentOption(ctx context.Context, value string, label string) {
	<button
		type="button"
		class="accent-swatch"
		data-accent-option={ value }
		aria-label={ label }
		aria-checked="false"
		role="radio"
		title={ label }
	>
		<span class="sr-only">{ label }</span>
	</button>
}

templ LocaleSwitcher(ctx context.Context) {
	{{ current := i18npkg.GetLocale(ctx) }}
	<nav aria-label={ i18npkg.T(ctx, "language_switcher") } class="flex items-center gap-1">
		<a
			href={ LangURL("en") }
			hx-get={ LangURL("en") }
			hx-target="body"
			hx-replace-url="true"
			class={ LangClass(current, "en") }
			if current == "en" {
				aria-current="true"
			}
		>EN</a>
		<a
			href={ LangURL("de") }
			hx-get={ LangURL("de") }
			hx-target="body"
			hx-replace-url="true"
			class={ LangClass(current, "de") }
			if current == "de" {
				aria-current="true"
			}
		>DE</a>
	</nav>
}
