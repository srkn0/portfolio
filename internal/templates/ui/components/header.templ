package components

import (
	"context"

	i18npkg "github.com/srkn0/main/pkg/i18n"
)

templ Header(ctx context.Context) {
	<header class="sticky top-0 z-50 px-4 py-3 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700">
		<div class="flex items-center justify-between max-w-5xl mx-auto">
			<a href="/" class="font-extrabold">SK</a>
			<nav class="flex gap-4 text-sm items-center">
				<a href="/blog">{ i18npkg.T(ctx, "nav_blog") }</a>
				<div class="flex items-center gap-1 text-xs">
					<a href="/lang?set=en" class="px-1.5 py-0.5 rounded">EN</a>
					<span>|</span>
					<a href="/lang?set=de" class="px-1.5 py-0.5 rounded">DE</a>
				</div>
				<button onclick="toggleTheme()" class="ml-2 p-1.5 rounded">☀</button>
			</nav>
		</div>
	</header>
}
