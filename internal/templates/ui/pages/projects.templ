package pages

import (
	"context"

	"github.com/srkn0/main/internal/content"
	"github.com/srkn0/main/internal/templates/constants"
	i18npkg "github.com/srkn0/main/pkg/i18n"
	"github.com/srkn0/main/pkg/templui/icon"
)

templ ProjectList(ctx context.Context, projects []content.ProjectSummary) {
	<section class="space-y-8" aria-labelledby="projects-title">
		<header class="space-y-3">
			<h1 id="projects-title" class="text-3xl font-semibold tracking-normal text-foreground">{ i18npkg.T(ctx, "projects_title") }</h1>
			<p class="max-w-[42rem] text-base leading-7 text-muted-foreground">{ i18npkg.T(ctx, "projects_intro") }</p>
		</header>

		if len(projects) == 0 {
			<p class="text-sm text-muted-foreground">{ i18npkg.T(ctx, "projects_empty") }</p>
		} else {
			<div class="divide-y divide-border">
				for _, project := range projects {
					@ProjectRow(ctx, project)
				}
			</div>
		}
	</section>
}

templ ProjectRow(ctx context.Context, project content.ProjectSummary) {
	<article class="project-row">
		<div class="min-w-0 space-y-2">
			<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
				<h3 class="text-base font-semibold leading-snug text-foreground">
					<a href={ "/projects/" + project.Slug } hx-get={ "/projects/" + project.Slug } hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true">{ project.Title }</a>
				</h3>
				<time datetime={ project.Date.Format("2006-01-02") } class="shrink-0 text-sm text-muted-foreground">{ project.Date.Format(i18npkg.DateFormat(ctx)) }</time>
			</div>
			if project.Description != "" {
				<p class="text-sm leading-6 text-muted-foreground">{ project.Description }</p>
			}
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				if len(project.Tags) > 0 {
					@TagList(project.Tags)
				}
				if project.Repo != "" {
					<a href={ project.Repo } class="inline-flex items-center gap-1 text-sm">
						@icon.Github(icon.Props{Class: "size-3.5"})
						{ i18npkg.T(ctx, "projects_repo") }
					</a>
				}
				if project.Demo != "" {
					<a href={ project.Demo } class="inline-flex items-center gap-1 text-sm">
						@icon.ExternalLink(icon.Props{Class: "size-3.5"})
						{ i18npkg.T(ctx, "projects_demo") }
					</a>
				}
			</div>
		</div>
	</article>
}

templ ProjectDetail(ctx context.Context, project content.Project) {
	<article class="article-shell">
		<header class="mb-9 space-y-4">
			@DetailBackLink("/projects", i18npkg.T(ctx, "back_to_projects"))
			<div class="space-y-3">
				<h1 class="text-3xl font-semibold tracking-normal text-foreground">{ project.Title }</h1>
				if project.Description != "" {
					<p class="max-w-[42rem] text-base leading-7 text-muted-foreground">{ project.Description }</p>
				}
				<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
					if len(project.Tags) > 0 {
						@TagList(project.Tags)
					}
					if project.Repo != "" {
						<a href={ project.Repo } class="inline-flex items-center gap-1 text-sm">
							@icon.Github(icon.Props{Class: "size-3.5"})
							{ i18npkg.T(ctx, "projects_repo") }
						</a>
					}
					if project.Demo != "" {
						<a href={ project.Demo } class="inline-flex items-center gap-1 text-sm">
							@icon.ExternalLink(icon.Props{Class: "size-3.5"})
							{ i18npkg.T(ctx, "projects_demo") }
						</a>
					}
				</div>
			</div>
			if project.Image != "" {
				<img src={ project.Image } alt="" class="max-h-64 w-full rounded-md border border-border object-cover"/>
			}
		</header>

		<div class="prose prose-neutral dark:prose-invert max-w-none">
			@templ.Raw(project.HTMLContent)
		</div>
	</article>
}
