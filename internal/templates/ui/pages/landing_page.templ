package pages

import (
	"context"

	"github.com/srkn0/main/internal/templates/constants"
	i18npkg "github.com/srkn0/main/pkg/i18n"
)

templ LandingPage(ctx context.Context, vm HomeViewModel) {
	<div class="space-y-12">
		<section class="space-y-5">
			<p class="text-sm font-medium text-muted-foreground">{ i18npkg.T(ctx, "home_intro_title") }</p>
			<div class="space-y-4 text-[1.03rem] leading-8 text-foreground">
				<p>{ i18npkg.T(ctx, "home_intro_body") }</p>
				<p>
					<a href="/blog" hx-get="/blog" hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true">{ i18npkg.T(ctx, "home_all_writing") }</a>
					<span class="mx-2 text-muted-foreground">/</span>
					<a href="/projects" hx-get="/projects" hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true">{ i18npkg.T(ctx, "home_all_projects") }</a>
					<span class="mx-2 text-muted-foreground">/</span>
					<a href="/contact" hx-get="/contact" hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true">{ i18npkg.T(ctx, "sidebar_contact") }</a>
				</p>
			</div>
		</section>

		<section class="space-y-4" aria-labelledby="home-latest-writing">
			@SectionHeader("home-latest-writing", i18npkg.T(ctx, "home_latest_writing"), "/blog", i18npkg.T(ctx, "home_all_writing"))
			if len(vm.LatestPosts) == 0 {
				<p class="text-sm text-muted-foreground">{ i18npkg.T(ctx, "writing_empty") }</p>
			} else {
				<div class="divide-y divide-border">
					for _, post := range vm.LatestPosts {
						@ArchiveRow(ctx, post)
					}
				</div>
			}
		</section>

		<section class="space-y-4" aria-labelledby="home-working-on">
			@SectionHeader("home-working-on", i18npkg.T(ctx, "home_working_on"), "/projects", i18npkg.T(ctx, "home_all_projects"))
			if len(vm.FeaturedProjects) == 0 {
				<p class="text-sm text-muted-foreground">{ i18npkg.T(ctx, "projects_empty") }</p>
			} else {
				<div class="divide-y divide-border">
					for _, project := range vm.FeaturedProjects {
						@ProjectRow(ctx, project)
					}
				</div>
			}
		</section>

		if len(vm.TopTags) > 0 {
			<section class="space-y-4" aria-labelledby="home-topics">
				<h2 id="home-topics" class="text-sm font-semibold uppercase tracking-[0.12em] text-muted-foreground">{ i18npkg.T(ctx, "home_topics") }</h2>
				<div class="flex flex-wrap gap-2">
					for _, tag := range vm.TopTags {
						<a href={ TagFilterURL(tag.Name) } hx-get={ TagFilterURL(tag.Name) } hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true" class="tag no-underline" data-tag-filter={ tag.Name }>{ TagCountLabel(tag) }</a>
					}
				</div>
			</section>
		}
	</div>
}

templ SectionHeader(id string, title string, href string, linkLabel string) {
	<div class="flex items-baseline justify-between gap-4 border-b border-border pb-2">
		<h2 id={ id } class="text-sm font-semibold uppercase tracking-[0.12em] text-muted-foreground">{ title }</h2>
		<a href={ href } class="shrink-0 text-sm">{ linkLabel }</a>
	</div>
}
