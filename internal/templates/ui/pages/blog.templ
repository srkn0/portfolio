package pages

import (
	"context"
	"fmt"

	"github.com/srkn0/main/internal/content"
	i18npkg "github.com/srkn0/main/pkg/i18n"
)

templ BlogList(ctx context.Context, posts []content.PostSummary, currentPage int, totalPages int) {
    <section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-foreground mb-8 sm:mb-10">{ i18npkg.T(ctx, "blog_title") }</h1>

        if len(posts) == 0 {
            <p class="text-muted-foreground">{ i18npkg.T(ctx, "blog_empty") }</p>
        }

        <div class="flex flex-col gap-6">
            for _, post := range posts {
                <a href={ "/blog/" + post.Slug } class="group block rounded-lg border border-border bg-card p-6 transition-colors hover:bg-accent/50 hover:border-primary/30">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center justify-between gap-4">
                            <h2 class="text-xl font-semibold text-foreground group-hover:text-primary transition-colors">{ post.Title }</h2>
                            <time class="text-sm text-muted-foreground whitespace-nowrap">{ post.Date.Format(i18npkg.DateFormat(ctx)) }</time>
                        </div>
                        if post.Description != "" {
                            <p class="text-muted-foreground text-sm leading-relaxed line-clamp-2">{ post.Description }</p>
                        }
                        if len(post.Tags) > 0 {
                            <div class="flex flex-wrap gap-2 mt-1">
                                for _, tag := range post.Tags {
                                    <span class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">{ tag }</span>
                                }
                            </div>
                        }
                    </div>
                </a>
            }
        </div>

        if totalPages > 1 {
            <nav class="flex items-center justify-center gap-4 mt-12">
                if currentPage > 1 {
                    <a href={ "/blog?page=" + fmt.Sprint(currentPage - 1) } class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-accent hover:border-primary/30">{ i18npkg.T(ctx, "blog_previous") }</a>
                }
                <span class="text-sm text-muted-foreground">{ fmt.Sprint(currentPage) } / { fmt.Sprint(totalPages) }</span>
                if currentPage < totalPages {
                    <a href={ "/blog?page=" + fmt.Sprint(currentPage + 1) } class="rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-accent hover:border-primary/30">{ i18npkg.T(ctx, "blog_next") }</a>
                }
            </nav>
        }
    </section>
}

templ BlogPost(ctx context.Context, post content.Post) {
    <article class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
        <header class="mb-10">
            <a href="/blog" class="text-sm text-muted-foreground hover:text-primary transition-colors">{ i18npkg.T(ctx, "back_to_blog") }</a>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground mt-4">{ post.Title }</h1>
            <div class="flex items-center gap-4 mt-3">
                <time class="text-sm text-muted-foreground">{ post.Date.Format(i18npkg.DateFormat(ctx)) }</time>
                if len(post.Tags) > 0 {
                    <div class="flex flex-wrap gap-2">
                        for _, tag := range post.Tags {
                            <span class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">{ tag }</span>
                        }
                    </div>
                }
            </div>
        </header>

        <div class="prose prose-neutral dark:prose-invert max-w-none">
            @templ.Raw(post.HTMLContent)
        </div>
    </article>
}
