package pages

import (
	"context"
	"fmt"

	"github.com/srkn0/main/internal/content"
	"github.com/srkn0/main/internal/templates/constants"
	i18npkg "github.com/srkn0/main/pkg/i18n"
)

templ BlogList(ctx context.Context, archive []content.PostArchiveYear) {
	<section class="space-y-8" aria-labelledby="posts-title">
		<header class="space-y-3">
			<h1 id="posts-title" class="text-3xl font-semibold tracking-normal text-foreground">{ i18npkg.T(ctx, "posts_title") }</h1>
			<p class="max-w-[42rem] text-base leading-7 text-muted-foreground">{ i18npkg.T(ctx, "posts_intro") }</p>
		</header>

		if len(archive) == 0 {
			<p class="text-sm text-muted-foreground">{ i18npkg.T(ctx, "posts_empty") }</p>
		} else {
			<div class="space-y-2">
				<label for="posts-search" class="text-sm font-medium text-foreground">{ i18npkg.T(ctx, "posts_search_label") }</label>
				<div class="relative">
					<input
						id="posts-search"
						type="search"
						class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30"
						placeholder={ i18npkg.T(ctx, "posts_search_placeholder") }
						data-posts-search
					/>
				</div>
				<div class="flex flex-wrap items-center justify-between gap-2">
					<p
						class="text-sm text-muted-foreground"
						aria-live="polite"
						data-posts-status
						data-result-label={ i18npkg.T(ctx, "posts_result_label") }
					></p>
					<div
						class="hidden items-center gap-2 rounded-md border border-border bg-secondary px-2 py-1 text-sm text-muted-foreground"
						data-posts-active-filter
						data-label-prefix={ i18npkg.T(ctx, "posts_filtered_by") }
					>
						<span data-posts-active-label></span>
						<a href="/blog" hx-get="/blog" hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true" class="text-xs">{ i18npkg.T(ctx, "posts_clear_filter") }</a>
					</div>
				</div>
			</div>

				<div class="space-y-10" data-posts-archive data-empty-text={ i18npkg.T(ctx, "posts_empty_filtered") }>
				for _, year := range archive {
						<section class="space-y-3" data-posts-year>
						<div class="flex items-baseline justify-between gap-4 border-b border-border pb-2">
							<h2 class="text-xl font-semibold text-foreground">{ fmt.Sprint(year.Year) }</h2>
							<p class="text-sm text-muted-foreground">{ YearCount(ctx, len(year.Posts)) }</p>
						</div>
						<div class="divide-y divide-border">
							for _, post := range year.Posts {
								@ArchiveRow(ctx, post)
							}
						</div>
					</section>
				}
			</div>
		}
	</section>
}

templ ArchiveRow(ctx context.Context, post content.PostSummary) {
	<article
		class="archive-row"
			data-posts-item
		data-title={ post.Title }
		data-description={ post.Description }
		data-tags={ TagsText(post.Tags) }
		data-year={ post.Date.Format("2006") }
	>
		<time datetime={ post.Date.Format("2006-01-02") } class="archive-date">{ post.Date.Format(i18npkg.DateFormat(ctx)) }</time>
		<div class="min-w-0 space-y-1">
			<h3 class="text-base font-semibold leading-snug text-foreground">
				<a href={ "/blog/" + post.Slug } hx-get={ "/blog/" + post.Slug } hx-target={ "#" + constants.PageLayoutID } hx-swap="outerHTML" hx-push-url="true">{ post.Title }</a>
			</h3>
			if post.Description != "" {
				<p class="text-sm leading-6 text-muted-foreground">{ post.Description }</p>
			}
			if len(post.Tags) > 0 {
				@TagList(post.Tags)
			}
		</div>
	</article>
}

templ BlogPost(ctx context.Context, post content.Post) {
	<article class="article-shell">
		<header class="mb-9 space-y-4">
			@DetailBackLink("/blog", i18npkg.T(ctx, "back_to_blog"))
			<div class="space-y-3">
				<h1 class="text-3xl font-semibold tracking-normal text-foreground">{ post.Title }</h1>
				<div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
					<time datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format(i18npkg.DateFormat(ctx)) }</time>
					if len(post.Tags) > 0 {
						@TagList(post.Tags)
					}
				</div>
			</div>
		</header>

		<div class="prose prose-neutral dark:prose-invert max-w-none">
			@templ.Raw(post.HTMLContent)
		</div>
	</article>
}

templ TagList(tags []string) {
	<div class="flex flex-wrap gap-1.5">
		for _, tag := range tags {
			<a href={ TagFilterURL(tag) } class="tag no-underline" data-tag-filter={ tag }>{ tag }</a>
		}
	</div>
}

templ ProjectTagList(tags []string) {
	<div class="flex flex-wrap gap-1.5">
		for _, tag := range tags {
			<span class="tag">{ tag }</span>
		}
	</div>
}
